# --- System ---
APP_NAME="NeoPulse"
ENV=dev
LOG_LEVEL=INFO
PAPER_TRADING=True   # True: simulated fills on live prices. False: real orders.

# --- Kotak Neo (required in both modes: market data needs a session) ---
NEO_ENVIRONMENT="prod"
NEO_CONSUMER_KEY=your_consumer_key
NEO_MOBILE=+91XXXXXXXXXX
NEO_MPIN=
NEO_UCC=your_unique_client_code
NEO_TOTP_SEED=YOUR_TOTP_SEED_HERE

# --- Telegram alerts (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_COMMANDS=True      # accept commands (incl. orders) from TELEGRAM_CHAT_ID

# --- Database ---
POSTGRES_USER="neopulse"
POSTGRES_PASSWORD="secure_password"
POSTGRES_DB="neopulse_db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432

# --- Risk & OMS (optional; defaults shown) ---
# MAX_DAILY_LOSS=2000          # net of charges; trips kill switch + flattens everything
# MAX_OPEN_POSITIONS=5
# ENTRY_CUTOFF=15:00           # no new entries after (IST)
# SQUARE_OFF_TIME=15:15        # intraday (MIS) positions closed (IST)
# MARKET_HOLIDAYS=2026-01-26    # comma separated NSE holidays (YYYY-MM-DD)
# ORDER_POLL_SECONDS=2
# LIMIT_ORDER_TTL_SECONDS=60
# PAPER_SLIPPAGE_BPS=2
